---
/* ==========================================================================
   Layout.astro — Document shell: head, global chrome, document-wide scripts.
   AffanShz Creative Portfolio / Dark Brutalist Tactical System.
   ========================================================================== */
import '../styles/base.css';
import '../styles/ui.css';
import '../styles/hud.css';
import '../styles/about.css';
import '../styles/loader.css';
import '../styles/work-grid.css';
import '../styles/err.css';
import '../styles/crt.css';
import '../styles/gate.css';

import Gate from '../components/Gate.astro';
import Loader from '../components/Loader.astro';
import Bar from '../components/Bar.astro';

interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="dark" />

    <link rel="preload" href="/fonts/PPSupplySans-Regular.woff" as="font" type="font/woff" crossorigin />

    <!-- Inline Gate & Loader Sentinel: Settled before first paint to prevent layout flash -->
    <script is:inline>
      (function () {
        var gated = !/[?&]mobile(&|=|$)/.test(location.search) &&
                    window.matchMedia &&
                    window.matchMedia('(max-width: 720px)').matches;
        if (gated) document.documentElement.className += ' is-gated';

        var reduced = window.matchMedia &&
                      window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (!gated && !reduced && !/[?&]skip(&|=|$)/.test(location.search)) {
          document.documentElement.className += ' is-loading';
        }
      })();
    </script>
  </head>
  <body>

    <!-- ==================================================================
         Mobile Gate Blocker (< 720px)
         ================================================================== -->
    <Gate />

    <!-- Persistent Hardware-Accelerated Film Grain & CRT Overlay -->
    <div class="grain" data-grain-animate="true" aria-hidden="true"></div>
    <div class="crt" aria-hidden="true"></div>

    <Loader />

    <main>
      <slot />
    </main>

    <!-- ==================================================================
         Bottom Navigation Bar (Shared Chrome)
         ================================================================== -->
    <Bar />

    <!-- Document-wide behaviour: gate watcher, scramble CTAs, sector sync -->
    <script>
      // ---- Gate watcher -------------------------------------------------
      // Toggles the mobile blocker live; ?mobile overrides the lock.
      (function () {
        const mql = window.matchMedia('(max-width: 720px)');
        const hasOverride = /[?&]mobile(&|=|$)/.test(location.search);

        function check() {
          if (hasOverride) {
            document.documentElement.classList.remove('is-gated');
            return;
          }
          document.documentElement.classList.toggle('is-gated', mql.matches);
        }

        mql.addEventListener?.('change', check);
        window.addEventListener('resize', check, { passive: true });
      })();

      // ---- Tactical copy email + hover descramble (runs behind gate too) -
      (function () {
        const CONFIG = {
          glyphs: '▘▙▚▛▜▝▞▟▖▗▄▀█▌▐▓▒░',
          speed: 1.2,
          holdMs: 2400,
          lockWidth: true,
          ask: 'CONFIRM TRANSMISSION?',
          insist: 'ESTABLISHING UPLINK...',
          give: 'COMMS LOCKED // COPIED'
        };

        const els = Array.from(document.querySelectorAll('[data-copy-email]'));
        const echo = Array.from(document.querySelectorAll('[data-scramble]'));
        if (!els.length && !echo.length) return;

        const rnd = () => CONFIG.glyphs[(Math.random() * CONFIG.glyphs.length) | 0];

        function scrambler(el: HTMLElement) {
          let raf = 0, frame = 0, q: any[] = [], busy = false, after: null | (() => void) = null;

          function step() {
            let out = '', done = 0;
            for (let i = 0; i < q.length; i++) {
              const c = q[i];
              if (c.to === ' ') { out += ' '; done++; continue; }
              if (frame >= c.end) { out += c.to; done++; }
              else if (frame >= c.start) {
                if (!c.ch || Math.random() < 0.3) c.ch = rnd();
                out += c.ch;
              } else {
                out += c.from;
              }
            }
            el.textContent = out;
            if (done === q.length) {
              busy = false;
              const fn = after;
              after = null;
              if (fn) fn();
              return;
            }
            frame++;
            raf = requestAnimationFrame(step);
          }

          return {
            get busy() { return busy; },
            to(next: string, done?: () => void) {
              const prev = el.textContent || '';
              const len = Math.max(prev.length, next.length);
              const s = Math.max(0.2, CONFIG.speed);
              q = [];
              for (let i = 0; i < len; i++) {
                const start = Math.floor((Math.random() * 10) / s);
                q.push({
                  from: prev[i] || ' ',
                  to: next[i] || '',
                  start,
                  end: start + Math.floor((Math.random() * 12 + 6) / s),
                  ch: ''
                });
              }
              cancelAnimationFrame(raf);
              frame = 0;
              busy = true;
              after = done || null;
              step();
            },
            stop() {
              cancelAnimationFrame(raf);
              busy = false;
              after = null;
            }
          };
        }

        async function copyText(text: string) {
          try {
            if (navigator.clipboard && navigator.clipboard.writeText) {
              await navigator.clipboard.writeText(text);
              return true;
            }
            throw new Error('no clipboard api');
          } catch (e) {
            const ta = document.createElement('textarea');
            ta.value = text;
            ta.setAttribute('readonly', '');
            ta.style.cssText = 'position:fixed;top:-1000px;opacity:0;';
            document.body.appendChild(ta);
            ta.select();
            let ok = false;
            try { ok = document.execCommand('copy'); } catch (err) { ok = false; }
            ta.remove();
            return ok;
          }
        }

        // Multi-phase Tactical Copy Button
        els.forEach(btn => {
          const email = (btn as HTMLElement).dataset.copyEmail || '';
          const label = btn.querySelector<HTMLElement>('[data-label]') || (btn as HTMLElement);
          const homeText = label.textContent!.trim();
          const sc = scrambler(label);
          let stage = 0, resetTimer = 0;

          function lock() {
            if (!CONFIG.lockWidth) return;
            const probe = document.createElement('span');
            const cs = getComputedStyle(label);
            probe.style.cssText =
              `position:absolute;visibility:hidden;white-space:pre;left:-9999px;` +
              `font:${cs.font};letter-spacing:${cs.letterSpacing};text-transform:${cs.textTransform};`;
            document.body.appendChild(probe);
            let maxW = 0;
            [homeText, CONFIG.ask, CONFIG.insist, CONFIG.give].forEach(t => {
              probe.textContent = t;
              maxW = Math.max(maxW, probe.getBoundingClientRect().width);
            });
            probe.remove();
            label.style.display = 'inline-block';
            label.style.minWidth = Math.ceil(maxW + 4) + 'px';
          }

          if (document.fonts && document.fonts.ready) {
            document.fonts.ready.then(lock).catch(lock);
          } else {
            lock();
          }

          function reset() {
            clearTimeout(resetTimer);
            stage = 0;
            btn.classList.remove('is-copied');
            sc.to(homeText);
          }

          btn.addEventListener('click', async (e: Event) => {
            e.preventDefault();
            clearTimeout(resetTimer);

            if (stage === 0) {
              stage = 1;
              sc.to(CONFIG.ask);
              resetTimer = setTimeout(reset, 3000);
            } else if (stage === 1) {
              stage = 2;
              sc.to(CONFIG.insist, async () => {
                await copyText(email);
                btn.classList.add('is-copied');
                sc.to(CONFIG.give);
                resetTimer = setTimeout(reset, CONFIG.holdMs);
              });
            }
          });

          btn.addEventListener('mouseleave', () => {
            if (stage === 1) resetTimer = setTimeout(reset, 1500);
          });
        });

        // Standard hover descramble for navigation elements
        echo.forEach(el => {
          const label = el.querySelector<HTMLElement>('[data-label]') || (el as HTMLElement);
          const homeText = label.textContent!.trim();
          const sc = scrambler(label);

          el.addEventListener('mouseenter', () => {
            if (sc.busy) return;
            sc.to(homeText);
          });
        });
      })();

      // ---- Sector scroll sync (skipped behind the mobile gate) -----------
      (function () {
        if (document.documentElement.classList.contains('is-gated')) return;

        const sections = Array.from(document.querySelectorAll<HTMLElement>('[data-section]'));
        if (!sections.length) return;

        const links = Array.from(document.querySelectorAll<HTMLElement>('.bar__btn[data-nav]'));
        const hud = document.querySelector<HTMLElement>('.hud');

        // data-section → nav anchor id
        const NAV: Record<string, string> = { mask: 'sec-index', design: 'sec-work', err: 'sec-err' };

        function sync() {
          const vh = window.innerHeight;
          const y = window.scrollY || document.documentElement.scrollTop;

          // Active sector = last one whose top passed the viewport midline
          let active = sections[0].dataset.section!;
          for (let i = 0; i < sections.length; i++) {
            if (sections[i].getBoundingClientRect().top <= vh * 0.5) {
              active = sections[i].dataset.section!;
            }
          }

          const target = NAV[active];
          for (let i = 0; i < links.length; i++) {
            links[i].classList.toggle('is-current', links[i].dataset.nav === target);
          }

          // HUD belongs to the INDEX sector — fade it out on the way down
          if (hud) {
            const fade = Math.max(0, Math.min(1, 1 - y / (vh * 0.7)));
            hud.style.opacity = fade.toFixed(3);
          }
        }

        window.addEventListener('scroll', sync, { passive: true });
        window.addEventListener('resize', sync, { passive: true });
        sync();
      })();
    </script>
  </body>
</html>
